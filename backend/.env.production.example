# PULSE Backend Production Environment Configuration
# Copy this to .env on your production server and configure with secret credentials.

# Managed PostgreSQL Connection URI (e.g. Neon, Supabase, AWS RDS, Cloud SQL)
# Must use TLS/SSL: sslmode=require
# Neon connection string format: postgresql://[user]:[password]@[endpoint]-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://pulse_admin:REPLACE_WITH_STRONG_PASSWORD@db.example.internal:5432/pulse_prod?sslmode=require

# Secure Random JWT Secret Key (Generate via: openssl rand -hex 32)
SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_HEX_STRING_MIN_64_CHARS

# JWT Algorithm
ALGORITHM=HS256

# JWT Expiration in minutes (e.g., 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed CORS Origins (Comma-separated list of HTTPS web dashboard origins)
CORS_ORIGINS=https://pulse.example.com,https://dashboard.pulse.example.com

# Cookie Security & Environment (Set COOKIE_SECURE=true when serving over HTTPS)
COOKIE_SECURE=true
ENVIRONMENT=production

# Public Web Application Base URL (Used for generating password reset links)
APP_BASE_URL=https://pulse.example.com

# Password Reset Email (SMTP) Configuration
# Leave SMTP_HOST empty to disable outbound email and log reset links to stdout
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=noreply@pulse.example.com

# Shared Live Monitor Storage (Upstash Redis for Vercel Serverless / Multi-Instance)
# Option 1: Upstash Redis REST API (Recommended for Vercel Serverless - HTTP-based, zero socket leaks)
UPSTASH_REDIS_REST_URL=https://REPLACE_WITH_UPSTASH_ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_REST_TOKEN

# Option 2: Standard Redis Connection URI (TCP/TLS)
REDIS_URL=rediss://default:REPLACE_WITH_PASSWORD@REPLACE_WITH_UPSTASH_ENDPOINT.upstash.io:6379

# Live Telemetry State TTL in seconds (auto-expires if desktop monitor disconnects)
LIVE_STATUS_TTL_SECONDS=15
