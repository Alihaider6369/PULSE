{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/css/:match*",
      "destination": "/frontend/css/:match*"
    },
    {
      "source": "/js/:match*",
      "destination": "/frontend/js/:match*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/desktop_app/resources/pulse.ico"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/index",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/live",
      "destination": "/frontend/live.html"
    },
    {
      "source": "/live.html",
      "destination": "/frontend/live.html"
    },
    {
      "source": "/history",
      "destination": "/frontend/history.html"
    },
    {
      "source": "/history.html",
      "destination": "/frontend/history.html"
    },
    {
      "source": "/settings",
      "destination": "/frontend/settings.html"
    },
    {
      "source": "/settings.html",
      "destination": "/frontend/settings.html"
    },
    {
      "source": "/reset-password",
      "destination": "/frontend/reset-password.html"
    },
    {
      "source": "/reset-password.html",
      "destination": "/frontend/reset-password.html"
    }
  ],
  "headers": [
    {
      "source": "/:match*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
